{
  "name": "nova-forge",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "Lightweight development SOP skills for Codex, Claude Code, and DeepSeek Harness.",
  "author": "Nova Forge contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kabulaka/nova-forge.git"
  },
  "engines": {
    "node": ">=22.5.0",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./dsh/index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-hook-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-hooks-claude-code": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  },
  "files": [
    ".agents/plugins/marketplace.json",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    ".codex-plugin/plugin.json",
    "codex/AGENTS.global.md",
    "dsh/",
    "hooks/",
    "skills/"
  ],
  "scripts": {
    "dev:install": "node scripts/install-dev-plugin.mjs",
    "dev:uninstall": "node scripts/uninstall-dev-plugin.mjs",
    "codex:dev:install": "node scripts/install-codex-dev-plugin.mjs",
    "codex:dev:uninstall": "node scripts/uninstall-codex-dev-plugin.mjs",
    "claude:dev:install": "node scripts/install-dev-plugin.mjs --host claude-code",
    "claude:dev:uninstall": "node scripts/uninstall-dev-plugin.mjs --host claude-code",
    "test": "node --test tests/*.test.mjs",
    "test:dsh": "node --test tests/dsh-runtime.integration.mjs",
    "check:version": "node scripts/sync-version.mjs --check",
    "check:plugin": "node scripts/validate-plugin.mjs",
    "check:release-notes": "node scripts/validate-release-notes.mjs",
    "check:workflow": "node scripts/validate-workflows.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run check:version && npm run check:plugin && npm run check:release-notes && npm run check:workflow && npm run test && npm run check:package"
  }
}
